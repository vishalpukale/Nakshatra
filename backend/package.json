{
  "name": "registration-microservices",
  "version": "1.0.0",
  "description": "Student event registration microservices architecture",
  "scripts": {
    "start": "concurrently \"npm run start:registration\" \"npm run start:gateway\"",
    "start:gateway": "cd api-gateway && npm run dev",
    "start:registration": "cd registration-service && npm run dev",
    "install:all": "npm install && cd shared && npm install && cd ../registration-service && npm install && cd ../api-gateway && npm install",
    "db:generate": "cd registration-service && npm run db:generate",
    "db:migrate": "cd registration-service && npm run db:migrate",
    "db:seed": "cd registration-service && npm run db:seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.9"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.844.0",
    "@aws-sdk/s3-request-presigner": "^3.844.0",
    "amqplib": "^0.10.7",
    "axios": "^1.8.4",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.41.0",
    "express": "^5.1.0",
    "express-http-proxy": "^2.1.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.6.0",
    "morgan": "^1.10.0",
    "pg": "^8.14.1",
    "redis": "^4.7.0",
    "rotating-file-stream": "^3.2.6",
    "ssh2-sftp-client": "^12.0.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2",
    "yamljs": "^0.3.0"
  }
}
