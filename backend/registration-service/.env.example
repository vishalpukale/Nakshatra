# Use this on Render or any host. Neon gives you this connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/nakshatra?sslmode=require

# Local Postgres can use these instead of DATABASE_URL.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=your_user
# DB_PASSWORD=your_password
# DB_NAME=nakshatra

PORT=3001
SECRET_JWT=replace-with-a-long-random-string
ADMIN_EMAIL=admin@nakshatra.local
ADMIN_PASSWORD=change-this-password
